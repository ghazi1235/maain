<?xml version="1.0" encoding="utf-8"?>
<!-- The menu's focus highlight: a glass row with the cyan-to-magenta hairline (the gradient layer
     showing through a 1dp inset), a faint neon wash inside, and a short cyan bar at the left edge
     as the cursor. MainActivity.MaxMenu slides one of these behind the focused row. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="0"
                android:startColor="#C005D9E8"
                android:centerColor="#6E8A4AD9"
                android:endColor="#C0FF2A6D" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#F40B0522" />
            <corners android:radius="13dp" />
        </shape>
    </item>
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="0"
                android:startColor="#3005D9E8"
                android:centerColor="#0A8A4AD9"
                android:endColor="#22FF2A6D" />
            <corners android:radius="13dp" />
        </shape>
    </item>
    <item
        android:width="3dp"
        android:height="22dp"
        android:gravity="start|center_vertical"
        android:left="10dp">
        <shape android:shape="rectangle">
            <solid android:color="#FF05D9E8" />
            <corners android:radius="2dp" />
        </shape>
    </item>
</layer-list>
