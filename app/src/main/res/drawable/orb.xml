<?xml version="1.0" encoding="utf-8"?>
<!-- The energy core at rest: magenta plasma lit from the upper left, a neon rim, a whisper of a
     cyan containment ring inside. Sized for a 124dp view (the insets assume it). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:centerX="0.40"
                android:centerY="0.36"
                android:gradientRadius="74%p"
                android:startColor="@color/accent_light"
                android:centerColor="@color/accent"
                android:endColor="@color/accent_dark" />
        </shape>
    </item>
    <!-- depth: the lower right falls into shadow -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:centerX="0.40"
                android:centerY="0.36"
                android:gradientRadius="70%p"
                android:startColor="#00000000"
                android:centerColor="#00000000"
                android:endColor="#73000000" />
        </shape>
    </item>
    <!-- neon rim -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#00000000" />
            <stroke
                android:width="1.5dp"
                android:color="#A6FF7FAE" />
        </shape>
    </item>
    <!-- containment ring -->
    <item
        android:left="15dp"
        android:top="15dp"
        android:right="15dp"
        android:bottom="15dp">
        <shape android:shape="oval">
            <solid android:color="#00000000" />
            <stroke
                android:width="1dp"
                android:color="#5C05D9E8" />
        </shape>
    </item>
    <!-- specular highlight -->
    <item
        android:left="22dp"
        android:top="12dp"
        android:right="60dp"
        android:bottom="78dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:centerX="0.5"
                android:centerY="0.5"
                android:gradientRadius="50%p"
                android:startColor="#B8FFFFFF"
                android:centerColor="#30FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
