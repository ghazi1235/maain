<?xml version="1.0" encoding="utf-8"?>
<!-- Reactive ring just outside the core: a soft outer glow and a crisp cyan line. Faint when
     idle; while listening it swells with the voice. Tinted magenta while speaking. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#00000000" />
            <stroke
                android:width="7dp"
                android:color="#3805D9E8" />
        </shape>
    </item>
    <item
        android:left="2.5dp"
        android:top="2.5dp"
        android:right="2.5dp"
        android:bottom="2.5dp">
        <shape android:shape="oval">
            <solid android:color="#00000000" />
            <stroke
                android:width="2dp"
                android:color="#E605D9E8" />
        </shape>
    </item>
</layer-list>
