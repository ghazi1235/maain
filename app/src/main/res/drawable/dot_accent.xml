    <gradient
        android:type="radial"
        android:centerX="0.5"
        android:centerY="0.5"
        android:gradientRadius="50%p"
        android:startColor="#FFFFFFFF"
        android:centerColor="#FF00F0FF"
        android:endColor="#0005D9E8" />
