<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <!-- Same drawable as the layout, so launch shows the finished background, not a flash. -->
        <item name="android:windowBackground">@drawable/bg_screen</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:colorBackground">@color/bg</item>
    </style>

    <!-- Small tracked-caps label: "YOU", "MAX", "LANGUAGE", the brand line. -->
    <style name="Tag">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:letterSpacing">0.24</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/neon_cyan</item>
        <item name="android:textSize">11sp</item>
        <item name="android:shadowColor">#7005D9E8</item>
        <item name="android:shadowRadius">8</item>
    </style>

    <!-- Remote legend pieces -->
    <style name="KeyCap">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">34dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/keycap</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- A value line in the menu's status panel, under its small Tag label. -->
    <style name="StatusValue">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">5dp</item>
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:shadowColor">#5A05D9E8</item>
        <item name="android:shadowRadius">8</item>
        <!-- Technical lines that may start with Arabic (the language name) still read left to right. -->
        <item name="android:textDirection">ltr</item>
    </style>

    <style name="KeyLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/text_dim</item>
        <item name="android:textSize">11sp</item>
    </style>
</resources>
